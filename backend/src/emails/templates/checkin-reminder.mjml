<mjml>
  <mj-body background-color="#f5f5f5">
    <!-- Header -->
    <mj-section background-color="#1a1a1a" padding="20px 0">
      <mj-column>
        <mj-image src="{{hotelLogo}}" alt="{{hotelName}}" width="180px" padding="0" />
      </mj-column>
    </mj-section>

    <!-- Alert Banner -->
    <mj-section background-color="#d4af37" padding="20px">
      <mj-column>
        <mj-text font-size="18px" color="#1a1a1a" font-weight="bold" align="center" padding="0">
          Your Stay is Almost Here!
        </mj-text>
        <mj-text font-size="13px" color="#1a1a1a" align="center" padding="5px 0 0 0">
          Check-in in 48 hours
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Personal Greeting -->
    <mj-section background-color="#ffffff" padding="40px 20px">
      <mj-column>
        <mj-text font-size="16px" color="#1a1a1a" font-weight="bold" padding="0 0 15px 0">
          Hi {{guestName}},
        </mj-text>
        <mj-text font-size="14px" color="#555555" line-height="1.6">
          We're excited to welcome you to {{hotelName}}! Your luxurious stay is just around the corner. Here's everything you need to know for a smooth check-in experience.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Check-in Details -->
    <mj-section background-color="#ffffff" padding="20px">
      <mj-column>
        <mj-text font-size="14px" color="#1a1a1a" font-weight="bold" padding="0 0 15px 0">
          Check-in Information
        </mj-text>
        
        <mj-table cellpadding="10px">
          <tr style="background-color: #f9f9f9; border-bottom: 2px solid #d4af37;">
            <td style="color: #1a1a1a; font-weight: bold;">Check-in Date</td>
            <td style="color: #d4af37; font-weight: bold;">{{checkInDate}}</td>
          </tr>
          <tr style="border-bottom: 1px solid #e0e0e0;">
            <td style="color: #555555;">Check-in Time</td>
            <td style="color: #1a1a1a;">3:00 PM onwards</td>
          </tr>
          <tr style="background-color: #f9f9f9; border-bottom: 1px solid #e0e0e0;">
            <td style="color: #555555;">Room Number</td>
            <td style="color: #1a1a1a;">{{roomNumber}}</td>
          </tr>
          <tr>
            <td style="color: #555555;">Check-out Date</td>
            <td style="color: #1a1a1a;">{{checkOutDate}} at 11:00 AM</td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <!-- Hotel Address & Parking -->
    <mj-section background-color="#ffffff" padding="20px">
      <mj-column>
        <mj-text font-size="14px" color="#1a1a1a" font-weight="bold" padding="0 0 15px 0">
          Hotel Address & Directions
        </mj-text>
        
        <mj-text font-size="12px" color="#555555" line-height="1.6" padding="0 0 15px 0">
          📍 {{hotelAddress}}<br/>
{{hotelCity}}, {{hotelCountry}}<br/>
📞 <a href="tel:{{hotelPhone}}" style="color: #d4af37; text-decoration: none;">{{hotelPhone}}</a>
        </mj-text>

        <mj-text font-size="13px" color="#1a1a1a" font-weight="bold" padding="0 0 10px 0">
          Parking Information
        </mj-text>
        <mj-text font-size="12px" color="#555555" line-height="1.6">
          🅿️ Complimentary valet parking is available at the main entrance. Our concierge team will assist you upon arrival.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- QR Code Section -->
    <mj-section background-color="#f9f9f9" padding="30px 20px">
      <mj-column>
        <mj-text font-size="13px" color="#1a1a1a" font-weight="bold" align="center" padding="0 0 15px 0">
          Fast Check-in with QR Code
        </mj-text>
        <mj-image src="{{qrCodeUrl}}" alt="Check-in QR Code" width="180px" align="center" padding="0" />
        <mj-text font-size="11px" color="#555555" align="center" padding="10px 0 0 0">
          Scan this code at check-in for faster processing
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Weather Forecast -->
    <mj-section background-color="#ffffff" padding="20px" border="1px solid #d4af37">
      <mj-column>
        <mj-text font-size="13px" color="#d4af37" font-weight="bold" padding="0 0 10px 0">
          🌤️ Weather Forecast
        </mj-text>
        <mj-text font-size="12px" color="#555555" line-height="1.5">
          {{weatherForecast}}
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Important Notes -->
    <mj-section background-color="#ffffff" padding="20px">
      <mj-column>
        <mj-text font-size="13px" color="#1a1a1a" font-weight="bold" padding="0 0 10px 0">
          Guest Services Available
        </mj-text>
        <mj-text font-size="12px" color="#555555" padding="5px 0">
          ✓ 24/7 Room Service<br/>
          ✓ Concierge Assistance<br/>
          ✓ Housekeeping Services<br/>
          ✓ Restaurant & Bar<br/>
          ✓ Wellness Center & Spa
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- CTA -->
    <mj-section background-color="#ffffff" padding="30px 20px">
      <mj-column>
        <mj-button background-color="#d4af37" color="#1a1a1a" font-weight="bold" href="{{bookingLink}}" padding="15px">
          View Your Reservation
        </mj-button>
      </mj-column>
    </mj-section>

    <!-- Contact Information -->
    <mj-section background-color="#ffffff" padding="30px 20px" border-top="2px solid #e0e0e0">
      <mj-column>
        <mj-text font-size="12px" color="#1a1a1a" font-weight="bold" padding="0 0 10px 0">
          Need Help?
        </mj-text>
        <mj-text font-size="12px" color="#555555" padding="0 0 5px 0">
          📧 <a href="mailto:{{hotelEmail}}" style="color: #d4af37; text-decoration: none;">{{hotelEmail}}</a>
        </mj-text>
        <mj-text font-size="12px" color="#555555" padding="0 0 5px 0">
          📞  <a href="tel:{{hotelPhone}}" style="color: #d4af37; text-decoration: none;">{{hotelPhone}}</a>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section background-color="#1a1a1a" padding="20px">
      <mj-column>
        <mj-text font-size="11px" color="#999999" align="center">
          © {{year}} {{hotelName}}. All rights reserved.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
