<mjml>
  <mj-body background-color="#f5f5f5">
    <!-- Header -->
    <mj-section background-color="#1a1a1a" padding="20px 0">
      <mj-column>
        <mj-image src="{{hotelLogo}}" alt="{{hotelName}}" width="180px" padding="0" />
      </mj-column>
    </mj-section>

    <!-- Alert Banner -->
    <mj-section background-color="#c44444" padding="25px 20px">
      <mj-column>
        <mj-text font-size="18px" color="#ffffff" font-weight="bold" align="center" padding="0">
          🔒 Password Reset Request
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Content -->
    <mj-section background-color="#ffffff" padding="40px 20px">
      <mj-column>
        <mj-text font-size="16px" color="#1a1a1a" font-weight="bold" padding="0 0 15px 0">
          Hi {{guestName}},
        </mj-text>
        
        <mj-text font-size="14px" color="#555555" line-height="1.6" padding="0 0 25px 0">
          We received a request to reset your password for your {{hotelName}} account. If you made this request, please click the button below to set a new password.
        </mj-text>

        <mj-text font-size="13px" color="#1a1a1a" font-weight="bold" padding="0 0 15px 0">
          ⏱️ This link expires in {{expiryMinutes}} minutes
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Reset Button -->
    <mj-section background-color="#ffffff" padding="20px">
      <mj-column>
        <mj-button background-color="#d4af37" color="#1a1a1a" font-weight="bold" href="{{resetLink}}" padding="15px" width="100%">
          Reset Your Password
        </mj-button>
      </mj-column>
    </mj-section>

    <!-- Security Notice -->
    <mj-section background-color="#fff3cd" padding="20px" border-left="4px solid #c44444">
      <mj-column>
        <mj-text font-size="13px" color="#c44444" font-weight="bold" padding="0 0 10px 0">
          ⚠️ Security Notice
        </mj-text>
        <mj-text font-size="12px" color="#555555" line-height="1.6">
          If you did NOT request a password reset, please ignore this email. Your account is secure and no changes have been made. Do not share this email or the reset link with anyone.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Additional Info -->
    <mj-section background-color="#ffffff" padding="30px 20px">
      <mj-column>
        <mj-text font-size="13px" color="#1a1a1a" font-weight="bold" padding="0 0 15px 0">
          Why We're Sending This
        </mj-text>
        <mj-text font-size="12px" color="#555555" line-height="1.6" padding="0 0 15px 0">
          Password reset requests are processed for your security. If this action was not authorized by you, please contact our support team immediately.
        </mj-text>

        <mj-text font-size="13px" color="#1a1a1a" font-weight="bold" padding="0 0 10px 0">
          What to do next:
        </mj-text>
        <mj-text font-size="12px" color="#555555">
          1. Click the reset link above<br/>
          2. Enter your new password<br/>
          3. Confirm your new password<br/>
          4. You'll be logged out and can log back in with your new password
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Do Not Reply Warning -->
    <mj-section background-color="#f0f0f0" padding="20px">
      <mj-column>
        <mj-text font-size="11px" color="#999999" align="center" line-height="1.5">
          ✋ This is an automated security email. <strong>Do not reply</strong> to this message.<br/>
          For assistance, contact our support team using the link below.
        </mj-text>
      </mj-column>
    </mj-section>

        <!-- Contact Information -->
    <mj-section background-color="#ffffff" padding="30px 20px" border-top="2px solid #e0e0e0">
      <mj-column>
        <mj-text font-size="12px" color="#1a1a1a" font-weight="bold" padding="0 0 10px 0">
          Need Help?
        </mj-text>
        <mj-text font-size="12px" color="#555555" padding="0 0 5px 0">
          📧 <a href="mailto:{{hotelEmail}}" style="color: #d4af37; text-decoration: none;">{{hotelEmail}}</a>
        </mj-text>
        <mj-text font-size="12px" color="#555555" padding="0 0 5px 0">
          📞 <a href="tel:{{hotelPhone}}" style="color: #d4af37; text-decoration: none;">{{hotelPhone}}</a>
        </mj-text>
        <mj-text font-size="12px" color="#555555" padding="0 0 5px 0">
          💬 <a href="{{hotelWebsite}}/support" style="color: #d4af37; text-decoration: none;">24/7 Live Chat</a>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section background-color="#1a1a1a" padding="20px">
      <mj-column>
        <mj-text font-size="11px" color="#999999" align="center">
          © {{year}} {{hotelName}}. All rights reserved.
        </mj-text>
        <mj-text font-size="11px" color="#999999" align="center" padding="5px 0 0 0">
          This is a security-related automated email.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
