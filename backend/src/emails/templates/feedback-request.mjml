<mjml>
  <mj-body background-color="#f5f5f5">
    <!-- Header -->
    <mj-section background-color="#1a1a1a" padding="20px 0">
      <mj-column>
        <mj-image src="{{hotelLogo}}" alt="{{hotelName}}" width="180px" padding="0" />
      </mj-column>
    </mj-section>

    <!-- Welcome Banner -->
    <mj-section background-color="#d4af37" padding="30px 20px">
      <mj-column>
        <mj-text font-size="22px" color="#1a1a1a" font-weight="bold" align="center" padding="0">
          How Was Your Stay?
        </mj-text>
        <mj-text font-size="13px" color="#1a1a1a" align="center" padding="10px 0 0 0">
          Your feedback helps us serve you better
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Guest Greeting -->
    <mj-section background-color="#ffffff" padding="40px 20px">
      <mj-column>
        <mj-text font-size="16px" color="#1a1a1a" font-weight="bold" padding="0 0 15px 0">
          Dear {{guestName}},
        </mj-text>
        <mj-text font-size="14px" color="#555555" line-height="1.6">
          Thank you for staying with us at {{hotelName}}! We hope you enjoyed your time and created wonderful memories. We'd love to hear about your experience.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Stay Details -->
    <mj-section background-color="#ffffff" padding="20px">
      <mj-column>
        <mj-text font-size="13px" color="#555555" padding="0 0 10px 0">
          <strong>Room {{roomNumber}}</strong> • Checked out on {{checkOutDate}}
        </mj-text>
      </mj-column>
    </mj-section>

       <!-- 5-Star Rating Section -->
    <mj-section background-color="#ffffff" padding="30px 20px">
      <mj-column>
        <mj-text font-size="14px" color="#1a1a1a" font-weight="bold" align="center" padding="0 0 15px 0">
          Rate Your Experience
        </mj-text>

        <!-- Static Star Rating Visual (Decorative Only) -->
        <mj-table align="center" cellpadding="5px" width="100%">
          <tr align="center">
            <td style="font-size: 28px; color: #d4af37;" width="20%">★</td>
            <td style="font-size: 28px; color: #d4af37;" width="20%">★</td>
            <td style="font-size: 28px; color: #d4af37;" width="20%">★</td>
            <td style="font-size: 28px; color: #d4af37;" width="20%">★</td>
            <td style="font-size: 28px; color: #ddd;" width="20%">★</td>
          </tr>
          <tr align="center">
            <td style="font-size: 11px; color: #999999;" colspan="5">
              Click below to share your detailed feedback
            </td>
          </tr>
        </mj-table>

        <mj-text font-size="12px" color="#555555" align="center" padding="20px 0 0 0">
          Your feedback helps us maintain the highest standards of luxury and service.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Feedback CTA -->
    <mj-section background-color="#ffffff" padding="20px">
      <mj-column>
        <mj-button background-color="#d4af37" color="#1a1a1a" font-weight="bold" href="{{feedbackLink}}" padding="15px" width="100%">
          Leave Your Review
        </mj-button>
      </mj-column>
    </mj-section>

    <!-- Feedback CTA -->
    <mj-section background-color="#ffffff" padding="30px 20px">
      <mj-column>
        <mj-button background-color="#d4af37" color="#1a1a1a" font-weight="bold" href="{{feedbackLink}}" padding="15px" width="100%">
          Leave Your Feedback
        </mj-button>
      </mj-column>
    </mj-section>

    <!-- Special Offer -->
    <mj-section background-color="#fffaf0" padding="25px 20px" border-radius="5px">
      <mj-column>
        <mj-text font-size="14px" color="#1a1a1a" font-weight="bold" align="center" padding="0 0 15px 0">
          🎁 Special Offer for You
        </mj-text>
        <mj-text font-size="13px" color="#d4af37" font-weight="bold" align="center" padding="0 0 10px 0">
          5% Discount on Your Next Stay
        </mj-text>
        <mj-text font-size="12px" color="#555555" align="center" line-height="1.6" padding="0 0 15px 0">
          Thank you for being a valued guest. Use code <strong>LOYALGUEST5</strong> on your next booking and save 5% on room rates.
        </mj-text>
        <mj-text font-size="11px" color="#999999" align="center">
          Valid for 60 days from checkout
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Areas for Feedback -->
    <mj-section background-color="#ffffff" padding="20px">
      <mj-column>
        <mj-text font-size="13px" color="#1a1a1a" font-weight="bold" padding="0 0 15px 0">
          We'd like to know about:
        </mj-text>
        <mj-text font-size="12px" color="#555555" padding="0 0 8px 0">
          🛏️ Room Cleanliness & Comfort<br/>
          🍽️ Food & Beverage Services<br/>
          👥 Staff Friendliness & Helpfulness<br/>
          🏨 Overall Experience<br/>
          💭 Additional Comments
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Contact Information -->
    <mj-section background-color="#ffffff" padding="30px 20px" border-top="2px solid #e0e0e0">
      <mj-column>
        <mj-text font-size="12px" color="#1a1a1a" font-weight="bold" padding="0 0 10px 0">
          Any Concerns?
        </mj-text>
        <mj-text font-size="12px" color="#555555" padding="0 0 5px 0">
          If you experienced any issues during your stay, please contact us directly:
        </mj-text>
        <mj-text font-size="12px" color="#555555" padding="5px 0">
          📧 <a href="mailto:{{hotelEmail}}" style="color: #d4af37; text-decoration: none;">{{hotelEmail}}</a><br/>
          📞 <a href="tel:{{hotelPhone}}" style="color: #d4af37; text-decoration: none;">{{hotelPhone}}</a><br/>
          💬 <a href="{{hotelWebsite}}/support" style="color: #d4af37; text-decoration: none;">24/7 Guest Support</a>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section background-color="#1a1a1a" padding="20px">
      <mj-column>
        <mj-text font-size="11px" color="#999999" align="center">
          © {{year}} {{hotelName}}. All rights reserved.
        </mj-text>
        <mj-text font-size="11px" color="#999999" align="center" padding="5px 0 0 0">
          This is an automated email. Please do not reply directly. Use the feedback link above.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
