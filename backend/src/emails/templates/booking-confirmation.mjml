<mjml>
  <mj-body background-color="#f5f5f5">
    <!-- Header -->
    <mj-section background-color="#1a1a1a" padding="20px 0">
      <mj-column>
        <mj-image src="{{hotelLogo}}" alt="{{hotelName}}" width="180px" padding="0" />
      </mj-column>
    </mj-section>

    <!-- Welcome Banner -->
    <mj-section background-color="#d4af37" padding="30px 20px">
      <mj-column>
        <mj-text font-size="24px" color="#1a1a1a" font-weight="bold" align="center" padding="0">
          Booking Confirmed
        </mj-text>
        <mj-text font-size="14px" color="#1a1a1a" align="center" padding="10px 0 0 0">
          Your luxury escape awaits
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Guest Greeting -->
    <mj-section background-color="#ffffff" padding="40px 20px">
      <mj-column>
        <mj-text font-size="16px" color="#1a1a1a" font-weight="bold" padding="0 0 15px 0">
          Dear {{guestName}},
        </mj-text>
        <mj-text font-size="14px" color="#555555" line-height="1.6">
          Thank you for choosing {{hotelName}}. We're delighted to confirm your upcoming reservation. Your stay promises an unforgettable experience of luxury and comfort.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Booking Summary -->
    <mj-section background-color="#ffffff" padding="20px">
      <mj-column>
        <mj-text font-size="14px" color="#1a1a1a" font-weight="bold" padding="0 0 15px 0">
          Booking Summary
        </mj-text>
        
        <mj-table cellpadding="10px" border="1px solid #d4af37">
          <tr style="background-color: #f9f9f9; border-bottom: 2px solid #d4af37;">
            <td style="color: #1a1a1a; font-weight: bold;">Detail</td>
            <td style="color: #1a1a1a; font-weight: bold;">Information</td>
          </tr>
          <tr>
            <td style="color: #555555;">Booking Reference</td>
            <td style="color: #d4af37; font-weight: bold;">{{bookingReference}}</td>
          </tr>
          <tr style="background-color: #f9f9f9;">
            <td style="color: #555555;">Room Number</td>
            <td style="color: #1a1a1a;">{{roomNumber}}</td>
          </tr>
          <tr>
            <td style="color: #555555;">Check-in Date</td>
            <td style="color: #1a1a1a;">{{checkInDate}}</td>
          </tr>
          <tr style="background-color: #f9f9f9;">
            <td style="color: #555555;">Check-out Date</td>
            <td style="color: #1a1a1a;">{{checkOutDate}}</td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <!-- Pricing Breakdown -->
    <mj-section background-color="#ffffff" padding="20px">
      <mj-column>
        <mj-text font-size="14px" color="#1a1a1a" font-weight="bold" padding="0 0 15px 0">
          Pricing Breakdown
        </mj-text>
        
        <mj-table cellpadding="10px">
          <tr style="border-bottom: 1px solid #e0e0e0;">
            <td style="color: #555555;">Room Rate ({{nights}} nights)</td>
<td style="color: #1a1a1a; text-align: right;">{{roomSubtotal}}</td>
          </tr>
          <tr style="border-bottom: 1px solid #e0e0e0; background-color: #f9f9f9;">
            <td style="color: #555555;">Taxes & Fees</td>
<td style="color: #1a1a1a; text-align: right;">{{taxAmount}}</td>
          </tr>
          <tr style="background-color: #f0f0f0;">
            <td style="color: #1a1a1a; font-weight: bold;">Total Amount</td>
            <td style="color: #d4af37; font-weight: bold; text-align: right; font-size: 16px;">{{totalAmount}}</td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <!-- Cancellation Policy -->
    <mj-section background-color="#fffaf0" padding="20px" border-radius="5px">
      <mj-column>
        <mj-text font-size="13px" color="#d4af37" font-weight="bold" padding="0 0 10px 0">
          ⚠️ Cancellation Policy
        </mj-text>
        <mj-text font-size="12px" color="#555555" line-height="1.5">
          Free cancellation up to 48 hours before check-in. Cancellations within 48 hours will be charged at full rate. For detailed terms and conditions, please visit our website or contact our reservations team.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- CTA -->
    <mj-section background-color="#ffffff" padding="30px 20px">
      <mj-column>
        <mj-button background-color="#d4af37" color="#1a1a1a" font-weight="bold" href="{{bookingLink}}" padding="15px">
          View Your Booking
        </mj-button>
      </mj-column>
    </mj-section>

        <!-- Contact Information -->
    <mj-section background-color="#ffffff" padding="30px 20px" border-top="2px solid #e0e0e0">
      <mj-column>
        <mj-text font-size="12px" color="#1a1a1a" font-weight="bold" padding="0 0 10px 0">
          Contact Us
        </mj-text>
        <mj-text font-size="12px" color="#555555" padding="0 0 5px 0">
          📧 <a href="mailto:{{hotelEmail}}" style="color: #d4af37; text-decoration: none;">{{hotelEmail}}</a>
        </mj-text>
        <mj-text font-size="12px" color="#555555" padding="0 0 5px 0">
          📞 <a href="tel:{{hotelPhone}}" style="color: #d4af37; text-decoration: none;">{{hotelPhone}}</a>
        </mj-text>
        <mj-text font-size="12px" color="#555555" padding="0 0 5px 0">
          🌐 <a href="{{hotelWebsite}}" style="color: #d4af37; text-decoration: none;">{{hotelWebsite}}</a>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section background-color="#1a1a1a" padding="20px">
      <mj-column>
        <mj-text font-size="11px" color="#999999" align="center">
          © {{year}} {{hotelName}}. All rights reserved.
        </mj-text>
        <mj-text font-size="11px" color="#999999" align="center" padding="5px 0 0 0">
          This is an automated email. Please do not reply directly.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
